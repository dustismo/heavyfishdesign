// Half-lap slot along an edge. One notch, material_thickness wide,
// slot_depth into the part (to the right of travel). slot_position is
// how far the notch starts from `from`.
{
    "params": {
        "from": "0,0",
        "to": "2,2",
        "material_thickness": 0.25,
        "slot_position": 0.5,
        "slot_depth": 0.5
    },
    "parts": [
        {
            "components": [
                {
                    "type": "basic_edge",
                    "custom_component": {
                        "type": "slot_joint"
                    },
                    "components": [
                        {
                            "type": "draw",
                            "commands": [
                                {
                                    "command": "move",
                                    "to": "0,0"
                                },
                                {
                                    "command": "line",
                                    "to": "slot_position,0"
                                },
                                {
                                    "command": "line",
                                    "to": "slot_position,slot_depth"
                                },
                                {
                                    "command": "line",
                                    "to": "slot_position + material_thickness,slot_depth"
                                },
                                {
                                    "command": "line",
                                    "to": "slot_position + material_thickness,0"
                                },
                                {
                                    "command": "line",
                                    "to": "width,0"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
